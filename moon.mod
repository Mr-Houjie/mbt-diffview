name = "Mr-Houjie/mbt-diffview"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/Mr-Houjie/mbt-diffview"

license = "MIT"

keywords = [ "diff", "viewer", "text", "cli", "gui", "developer-tools" ]

